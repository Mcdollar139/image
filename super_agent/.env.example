# ─── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Recommended (web search quality) ───────────────────────────────────────
# Sign up: https://tavily.com — free tier 1000 searches/month.
# If unset, web_search falls back to DuckDuckGo automatically.
TAVILY_API_KEY=

# ─── Recommended (on-chain data — higher rate limits) ───────────────────────
# Etherscan: https://etherscan.io/myapikey  (free)
ETHERSCAN_API_KEY=
# Solscan:   https://pro-api.solscan.io     (free tier available)
SOLSCAN_API_KEY=

# ─── Model overrides (optional) ─────────────────────────────────────────────
# Main loop (default: claude-opus-4-7)
SUPER_AGENT_MODEL=claude-opus-4-7
# Subagent mixing — sonnet for research/structured, haiku for simple tasks
SUPER_AGENT_SUBAGENT_MODEL_SONNET=claude-sonnet-4-6
SUPER_AGENT_SUBAGENT_MODEL_HAIKU=claude-haiku-4-5

# ─── Memory store ───────────────────────────────────────────────────────────
SUPER_AGENT_MEMORY_DIR=./memory_store
